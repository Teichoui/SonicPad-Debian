[Unit]
Description=Regenerate per-device WiFi MAC address (runs once, first boot only)
DefaultDependencies=no
After=local-fs.target
Before=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/regen_wifi_mac.sh

[Install]
RequiredBy=systemd-modules-load.service
